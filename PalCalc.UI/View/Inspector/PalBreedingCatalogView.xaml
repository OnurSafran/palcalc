<UserControl x:Class="PalCalc.UI.View.Inspector.PalBreedingCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PalCalc.UI.View.Inspector"
             xmlns:vm="clr-namespace:PalCalc.UI.ViewModel.Inspector"
             xmlns:model="clr-namespace:PalCalc.Model;assembly=PalCalc.Model"
             xmlns:itl="clr-namespace:PalCalc.UI.Localization"
             xmlns:c="clr-namespace:PalCalc.UI.ViewModel.Converters"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             mc:Ignorable="d" 
             d:DataContext="{x:Static vm:PalBreedingCatalogViewModel.DesignerInstance}"
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.Resources>
        <c:ValueVisibilityConverter x:Key="VVC" />
        <c:ValueVisibilityConverter x:Key="VVC_Negate" Negate="True" />

        <!-- Status Color Brushes -->
        <SolidColorBrush x:Key="ReadyBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="MissingPairBrush" Color="#D84315" />
        <SolidColorBrush x:Key="UnavailableBrush" Color="#757575" />
        <SolidColorBrush x:Key="SameGenderBrush" Color="#F57F17" />
        <SolidColorBrush x:Key="OneParentBrush" Color="#0277BD" />
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="340" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Catalog & Controls -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search, Filter & Sort Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,4,0"
                         ToolTip="{itl:LocalizedText LC_BREEDING_SEARCH_HINT}" />

                <ComboBox Grid.Column="1"
                          SelectedValue="{Binding SelectedFilter}"
                          SelectedValuePath="Tag"
                          Width="110" Margin="0,0,4,0">
                    <ComboBoxItem Tag="{x:Static vm:PalCatalogFilterOption.All}" Content="{Binding FilterAllText.Value}" />
                    <ComboBoxItem Tag="{x:Static vm:PalCatalogFilterOption.Owned}" Content="{Binding FilterOwnedText.Value}" />
                    <ComboBoxItem Tag="{x:Static vm:PalCatalogFilterOption.BreedableNow}" Content="{Binding FilterBreedableText.Value}" />
                </ComboBox>

                <ComboBox Grid.Column="2"
                          SelectedValue="{Binding SelectedSort}"
                          SelectedValuePath="Tag"
                          Width="90">
                    <ComboBoxItem Tag="{x:Static vm:PalCatalogSortOption.PalDex}" Content="{Binding SortPaldexText.Value}" />
                    <ComboBoxItem Tag="{x:Static vm:PalCatalogSortOption.Name}" Content="{Binding SortNameText.Value}" />
                </ComboBox>
            </Grid>

            <!-- Virtualized Pal Cards Grid -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding VisibleEntries}"
                     SelectedItem="{Binding SelectedEntry}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Pal.Label.Value}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding StatusText.Value}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel SpacingMode="None" StretchItems="False" AllowDifferentSizedItems="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PalCatalogEntryViewModel}">
                        <Border BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                                Width="140" Margin="3" Padding="6">
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel Width="220">
                                        <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding Pal.Name.Value}" />
                                        <TextBlock Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" Text="{Binding PaldexDisplay.Value}" />
                                        <Separator Margin="0,4" />
                                        <TextBlock Text="{Binding OwnedCountsDisplay.Value}" />
                                        <TextBlock Text="{Binding MatchingPairCountDisplay.Value}" />
                                        <TextBlock FontWeight="Bold" Margin="0,4,0,0" Text="{Binding StatusText.Value}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Ready}">
                                                            <Setter Property="Foreground" Value="{StaticResource ReadyBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.MissingPair}">
                                                            <Setter Property="Foreground" Value="{StaticResource MissingPairBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Unavailable}">
                                                            <Setter Property="Foreground" Value="{StaticResource UnavailableBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon & Dex Number Badge -->
                                <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Image Source="{Binding Pal.Icon}" Width="48" Height="48" />
                                    <Border Background="#CC000000" CornerRadius="3" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding PaldexNoDisplay}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <!-- Pal Name -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Pal.Name.Value}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />

                                <!-- Owned Breakdown -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding OwnedCountsDisplay.Value}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}"
                                           Margin="0,0,0,4" />

                                <!-- Compact Status Tag -->
                                <Border Grid.Row="3" CornerRadius="3" Padding="4,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Ready}">
                                                    <Setter Property="Background" Value="#202E7D32" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.MissingPair}">
                                                    <Setter Property="Background" Value="#20D84315" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Unavailable}">
                                                    <Setter Property="Background" Value="#20757575" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText.Value}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Ready}">
                                                        <Setter Property="Foreground" Value="{StaticResource ReadyBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.MissingPair}">
                                                        <Setter Property="Foreground" Value="{StaticResource MissingPairBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Unavailable}">
                                                        <Setter Property="Foreground" Value="{StaticResource UnavailableBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Right Pane: Selected Detail View -->
        <Border Grid.Column="2"
                BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1BorderBrush}}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                Padding="8">
            <DockPanel>
                <!-- Active Save Scope Disclosure -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.ActiveScopeDescription.Value}"
                           AutomationProperties.Name="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.ActiveScopeDescription.Value}"
                           FontSize="10"
                           FontStyle="Italic"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}"
                           Margin="0,0,0,6"
                           HorizontalAlignment="Right" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedDetails}">
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding Pal.Icon}" Width="64" Height="64" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Pal.Name.Value}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding PaldexDisplay.Value}" Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OwnedCountsDisplay.Value}" FontSize="12" />
                            <TextBlock FontWeight="Bold" FontSize="13" Margin="0,4,0,0" Text="{Binding StatusText.Value}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Ready}">
                                                <Setter Property="Foreground" Value="{StaticResource ReadyBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.MissingPair}">
                                                <Setter Property="Foreground" Value="{StaticResource MissingPairBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static model:PalBreedingStatus.Unavailable}">
                                                <Setter Property="Foreground" Value="{StaticResource UnavailableBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,12" />

                    <!-- Owned Instances Section -->
                    <TextBlock Text="{itl:LocalizedText LC_BREEDING_OWNED_INSTANCES}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OwnedInstances}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}"
                                        BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName.Value}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LocationDescription.Value}" FontSize="11" Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />
                                            <TextBlock Text="{itl:LocalizedText LC_BREEDING_ON_EXPEDITION}"
                                                       Visibility="{Binding IsOnExpedition, Converter={StaticResource VVC}}"
                                                       Foreground="{StaticResource SameGenderBrush}" FontSize="10" FontWeight="Bold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Gender.Value}" Margin="0,0,8,0" FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{itl:LocalizedText LC_COMMON_LEVEL}" FontSize="11" />
                                                <TextBlock Text="{Binding Level, StringFormat=': {0}'}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,0,0,12" />

                    <!-- Breeding Recipes Section -->
                    <TextBlock Text="{itl:LocalizedText LC_BREEDING_RECIPES}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Recipes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PalBreedingRecipeViewModel}">
                                <Border BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}"
                                        BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4"
                                        Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}">
                                    <StackPanel>
                                        <!-- Parents Line -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Parent1.Icon}" Width="24" Height="24" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Parent1.Name.Value}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Parent1CountsDisplay.Value}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text=" + " FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Parent2.Icon}" Width="24" Height="24" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Parent2.Name.Value}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Parent2CountsDisplay.Value}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Recipe Status Badge & Parent Counts -->
                                        <TextBlock FontSize="11" FontWeight="Bold" Margin="0,2,0,4" Text="{Binding StatusText.Value}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static model:RecipeAvailabilityStatus.BothParentsOwned}">
                                                            <Setter Property="Foreground" Value="{StaticResource ReadyBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static model:RecipeAvailabilityStatus.IncompatibleParentsOwned}">
                                                            <Setter Property="Foreground" Value="{StaticResource SameGenderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static model:RecipeAvailabilityStatus.OneParentOwned}">
                                                            <Setter Property="Foreground" Value="{StaticResource OneParentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static model:RecipeAvailabilityStatus.NeitherParentOwned}">
                                                            <Setter Property="Foreground" Value="{StaticResource UnavailableBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Matching Pairs List -->
                                        <Expander Header="{Binding MatchingPairCountDisplay.Value}" IsExpanded="False" Visibility="{Binding HasMatchingPairs, Converter={StaticResource VVC}}">
                                            <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DisplayedPairsNotice.Value}"
                                                       Visibility="{Binding HasMoreMatchingPairs, Converter={StaticResource VVC}}"
                                                       FontSize="10" FontStyle="Italic" Margin="4,0,4,4" />
                                            <ItemsControl ItemsSource="{Binding MatchingPairs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PalBreedingPairViewModel}">
                                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer3BorderBrush}}" Padding="4">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Parent1Instance.DisplayName.Value}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Parent1Instance.Gender.Value}" FontSize="10" />
                                                                        <TextBlock Text="{Binding Parent1Instance.LocationDescription.Value}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text=" ↔ " FontSize="10" />
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{Binding Parent2Instance.DisplayName.Value}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Parent2Instance.Gender.Value}" FontSize="10" />
                                                                        <TextBlock Text="{Binding Parent2Instance.LocationDescription.Value}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Visibility="{Binding HasExpeditionParent, Converter={StaticResource VVC}}"
                                                                           Text="{Binding ExpeditionWarningText.Value}"
                                                                           Foreground="{StaticResource SameGenderBrush}"
                                                                           FontSize="10" FontWeight="Bold" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
