<UserControl x:Class="PalCalc.UI.View.YourPalsOrphanedDocumentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PalCalc.UI.ViewModel"
             xmlns:itl="clr-namespace:PalCalc.UI.Localization"
             xmlns:c="clr-namespace:PalCalc.UI.ViewModel.Converters"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             mc:Ignorable="d"
             d:DataContext="{x:Static vm:YourPalsViewModel.DesignerInstance}">
    <UserControl.Resources>
        <c:ValueVisibilityConverter x:Key="VVC" />
        <c:ValueVisibilityConverter x:Key="VVC_Negate" Negate="True" />
    </UserControl.Resources>

    <Border Padding="10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{itl:LocalizedText LC_YOUR_PALS_BACK_TO_SAVE_SELECTION}"
                            Command="{Binding BackCommand}"
                            Padding="8,3"
                            Margin="0,0,10,0" />
                    <TextBlock Text="{itl:LocalizedText LC_YOUR_PALS_ORPHANED_DOCUMENTS}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{itl:LocalizedText LC_YOUR_PALS_DESCRIPTION}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}"
                           Margin="0,5,0,0" />
                <TextBlock Text="{Binding OrphanedDocumentCountText}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Grid>
                <ListView ItemsSource="{Binding OrphanedDocuments}"
                          SelectedItem="{Binding SelectedOrphanedDocument, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          Visibility="{Binding HasOrphanedDocuments, Converter={StaticResource VVC}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6" Margin="0,0,0,4" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{itl:LocalizedText LC_YOUR_PALS_OWNER}" FontWeight="SemiBold" Margin="0,0,8,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding OwnerLabel}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                    <TextBlock Grid.Row="1" Text="{itl:LocalizedText LC_YOUR_PALS_REASON}" FontWeight="SemiBold" Margin="0,0,8,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                    <TextBlock Grid.Row="2" Text="{itl:LocalizedText LC_YOUR_PALS_DOCUMENT}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DocumentPath}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="{itl:LocalizedText LC_YOUR_PALS_NO_ORPHANED_DOCUMENTS}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasOrphanedDocuments, Converter={StaticResource VVC_Negate}}" />
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{itl:LocalizedText LC_YOUR_PALS_REFRESH}"
                        Command="{Binding RefreshOrphanedDocumentsCommand}"
                        Padding="8,3"
                        Margin="0,0,5,0" />
                <Button Content="{itl:LocalizedText LC_YOUR_PALS_DELETE_SELECTED_ORPHAN}"
                        Command="{Binding DeleteSelectedOrphanedDocumentCommand}"
                        Padding="8,3" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
